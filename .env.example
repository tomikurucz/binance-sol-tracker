# Masold le .env nevre es toltsd ki. A .env SOHA ne keruljon a git repoba!
# Csak azt a csatornat kell kitolteni, amelyiket hasznalod (a tobbi maradhat ures).

# 1) ntfy.sh - INGYENES, nem kell regisztracio (ajanlott kezdesnek)
#    Telepitsd a "ntfy" appot a telefonra, es iratkozz fel ugyanerre a topicra.
NTFY_TOPIC=

# 2) Telegram bot - @BotFather-nal csinalj botot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Discord webhook
DISCORD_WEBHOOK_URL=

# 4) Pushover (fizetos, de nagyon megbizhato)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Opcionalis: sajat ntfy szerver / token
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
