# Masold le .env nevre es toltsd ki. A .env SOHA ne keruljon a git repoba!
# Csak azt a csatornat kell kitolteni, amelyiket hasznalod (a tobbi maradhat ures).

# 1) ntfy.sh - INGYENES, nem kell regisztracio (ajanlott kezdesnek)
#    Telepitsd a "ntfy" appot a telefonra, es iratkozz fel ugyanerre a topicra.
NTFY_TOPIC=

# 2) Telegram bot - @BotFather-nal csinalj botot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Discord webhook
DISCORD_WEBHOOK_URL=

# 4) Pushover (fizetos, de nagyon megbizhato)
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Opcionalis: sajat ntfy szerver / token
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# ── Binance Futures kereskedelem (--trade) ──────────────────────────────
# Csak akkor kell kitolteni, ha a --trade flaggel valodi megbizasokat akarsz kuldni.
# A kulcson csak "Enable Futures" jog legyen - "Withdraw" SOHA!
# Javasolt: IP-szures bekapcsolasa a Binance API kezeloben.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Testnet / Demo Trading kulcsok (--testnet) ─────────────────────────
# A Binance a regi "Futures Testnet" feluletet a Demo Tradingbe olvasztotta:
# a kulcsot a https://www.binance.com/en/demo-trading oldalon (Demo Trading mod
# -> API Management) hozod letre, a valodi Binance fiokoddal bejelentkezve.
# A demo kulcs CSAK a demo vegpontokon mukodik (USD-M futures: demo-fapi.binance.com).
# Testneten MINDIG kulon kulcsot hasznalj (a valodi kulcsot a testnet elutasitja).
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Regi nev (a klasszikus testnet kulcsokhoz) - ugyanugy mukodik:
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# 1 = testnet/demo mod: a kereskedes ES a piaci adat is a testnetrol jon.
# BINANCE_FUTURES_TESTNET=1

# Opcionalis: kezzel megadott futures host (ha nem akarod az automatikus
# host-valasztast, pl. https://demo-fapi.binance.com vagy https://testnet.binancefuture.com)
# BINANCE_FUTURES_BASE_URL=
